{
  "id": "nomad",
  "name": "Nomad",
  "version": "1.3.1",
  "description": "Native Nomad workload, cluster, storage and access management in Termix.",
  "author": { "name": "Local development" },
  "license": "Apache-2.0",
  "category": "Infrastructure",
  "icon": "Network",
  "features": [
    "Connect a Nomad cluster to a Termix host with an encrypted ACL token",
    "Operate jobs, versions, deployments, evaluations and allocations",
    "Inspect topology, nodes, servers, services, storage and variables",
    "Show allocation-scoped Consul service health and a safe link to Consul UI",
    "Create complete HCL/JSON jobs with syntax/configuration validation, variables and guarded plans",
    "Debug tasks with live logs, filesystem browsing and authenticated exec",
    "Administer namespaces and ACLs with separate privileged permissions"
  ],
  "engine": { "termix": ">=26.11.0", "api": "^1.9" },
  "capabilities": ["hosts:read", "network:outbound", "network:serve", "ui:surface"],
  "contributes": {
    "tabs": [
      { "id": "nomad", "titleKey": "nav.nomad", "icon": "Network", "openFrom": ["rail", "host-context-menu", "palette"] }
    ],
    "permissions": [
      { "name": "use", "titleKey": "permissions.use.title", "descriptionKey": "permissions.use.description", "defaultRoles": ["admin", "user"] },
      { "name": "manage", "titleKey": "permissions.manage.title", "descriptionKey": "permissions.manage.description", "defaultRoles": ["admin"] },
      { "name": "exec", "titleKey": "permissions.exec.title", "descriptionKey": "permissions.exec.description", "defaultRoles": ["admin"] },
      { "name": "administer", "titleKey": "permissions.administer.title", "descriptionKey": "permissions.administer.description", "defaultRoles": ["admin"] }
    ],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 35,
        "enableKey": "enableNomad",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          { "key": "address", "type": "string", "labelKey": "settings.host.address.label", "descriptionKey": "settings.host.address.description", "default": "", "requires": "enableNomad" },
          { "key": "token", "type": "secret", "labelKey": "settings.host.token.label", "descriptionKey": "settings.host.token.description", "requires": "enableNomad" },
          { "key": "nomadUiUrl", "type": "string", "labelKey": "settings.host.nomadUiUrl.label", "descriptionKey": "settings.host.nomadUiUrl.description", "default": "", "requires": "enableNomad" },
          { "key": "region", "type": "string", "labelKey": "settings.host.region.label", "default": "global", "requires": "enableNomad" },
          { "key": "consulAddress", "type": "string", "labelKey": "settings.host.consulAddress.label", "descriptionKey": "settings.host.consulAddress.description", "default": "", "requires": "enableNomad" },
          { "key": "consulToken", "type": "secret", "labelKey": "settings.host.consulToken.label", "descriptionKey": "settings.host.consulToken.description", "requires": "enableNomad" },
          { "key": "consulUiUrl", "type": "string", "labelKey": "settings.host.consulUiUrl.label", "descriptionKey": "settings.host.consulUiUrl.description", "default": "", "requires": "enableNomad" }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
